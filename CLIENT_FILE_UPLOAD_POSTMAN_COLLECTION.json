{
  "info": {
    "name": "OSM Client File Upload API",
    "description": "Comprehensive test collection for OSM client file upload system including generic, finance, and production endpoints",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "your-jwt-token-here",
      "type": "string"
    },
    {
      "key": "client_id",
      "value": "CLIENT_001",
      "type": "string"
    },
    {
      "key": "test_file_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Generic Client File Upload",
      "item": [
        {
          "name": "Upload Client File",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has success true\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "});",
                  "",
                  "pm.test(\"Response contains file ID\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.not.be.empty;",
                  "    pm.collectionVariables.set(\"test_file_id\", jsonData.data);",
                  "});",
                  "",
                  "pm.test(\"Upload message is correct\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql(\"File uploaded successfully\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/files/client/{{client_id}}/CONTRACTS/CONTRACT_001/upload",
              "host": ["{{base_url}}"],
              "path": ["api", "files", "client", "{{client_id}}", "CONTRACTS", "CONTRACT_001", "upload"]
            },
            "description": "Upload a file for a specific client and entity type"
          }
        },
        {
          "name": "Download Client File",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is binary data\", function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.not.be.undefined;",
                  "});",
                  "",
                  "pm.test(\"Content-Disposition header exists\", function () {",
                  "    pm.expect(pm.response.headers.get('Content-Disposition')).to.include('attachment');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/files/client/download/{{test_file_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "files", "client", "download", "{{test_file_id}}"]
            },
            "description": "Download a file by file ID"
          }
        },
        {
          "name": "Get File Metadata",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains file metadata\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data).to.have.property('id');",
                  "    pm.expect(jsonData.data).to.have.property('name');",
                  "    pm.expect(jsonData.data).to.have.property('size');",
                  "    pm.expect(jsonData.data).to.have.property('mimeType');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/files/client/metadata/{{test_file_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "files", "client", "metadata", "{{test_file_id}}"]
            },
            "description": "Get metadata for a specific file"
          }
        },
        {
          "name": "List Client Files",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains file list\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/files/client/{{client_id}}/files?entityName=CONTRACTS&pageSize=20",
              "host": ["{{base_url}}"],
              "path": ["api", "files", "client", "{{client_id}}", "files"],
              "query": [
                {
                  "key": "entityName",
                  "value": "CONTRACTS"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            },
            "description": "List files for a specific client and entity"
          }
        },
        {
          "name": "Find Client File by Object ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 404\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Response contains file info\", function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.success).to.eql(true);",
                  "        pm.expect(jsonData.data).to.have.property('id');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/files/client/{{client_id}}/CONTRACTS/CONTRACT_001",
              "host": ["{{base_url}}"],
              "path": ["api", "files", "client", "{{client_id}}", "CONTRACTS", "CONTRACT_001"]
            },
            "description": "Find a specific file by client ID, entity, and object ID"
          }
        }
      ]
    },
